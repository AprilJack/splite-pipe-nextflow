// nextflow.config
// ============================================================================
//  All run settings live here - main.nf does not need to be edited.
//
//  Override any value without editing this file:
//    nextflow run main.nf --outdir /path/to/result --split_cpus 32
//    nextflow run main.nf -params-file my_run.yaml
//    nextflow run main.nf -profile slurm
// ============================================================================

params {
    // ---------------------------------------------------------------- Input
    // Option A: glob of paired FASTQs ({R1,R2} marks the read pair)
    fqfiles      = "/vast/igc/analyses/april/BLUM/tracy/261002_parse_repeat/fastq/Sub_*_{R1,R2}.fastq.gz"
    // Option B: samplesheet CSV with columns sublibrary,fastq_1,fastq_2[,sample_list]
    //           (takes priority over fqfiles when set)
    input        = null

    // How sublibrary names are built from the FASTQ pair id (fqfiles only).
    // Pair id "120423Parse_S1_group_mm" + regex below -> "S1" -> "sub_S1"
    sublib_regex  = '^[^_]+_([^_]+)'
    sublib_prefix = 'sub_'

    // ----------------------------------------------------------- References
    genome_dir   = "/vast/igc/data/genomes/parse_genomes/mm39"
    sample_list  = "/vast/igc/analyses/april/BLUM/tracy/261002_parse_repeat/sample_list.txt"

    // --------------------------------------------------------------- Output
    outdir       = "/vast/igc/analyses/april/BLUM/tracy/261002_parse_repeat/results"
    combined_dir = null                 // null -> "${outdir}/combined"

    // ---------------------------------------------------- split-pipe options
    split_pipe_bin     = 'split-pipe'   // or a full path to the executable
    mode               = 'all'
    chemistry          = 'v4'
    kit                = 'WT'
    kit_score_skip     = false
    start_timeout      = 120            // null to omit
    dryrun             = false
    split_extra_args   = ''             // any extra args for each sublibrary run
    combine_extra_args = ''             // any extra args for the combine run

    // ---------------------------------------------------------- Combine step
    skip_combine = false                // true = only process sublibraries
    combine_only = false                // true = only combine existing sublibraries
    sublib_list  = null                 // list of sublibrary dirs (combine_only)

    // ------------------------------------------------------------- Resources
    split_cpus     = 12
    split_memory   = null               // e.g. '256 GB' (null = not requested)
    split_time     = null               // e.g. '48h'
    combine_cpus   = 12
    combine_memory = null
    combine_time   = null
    max_parallel   = 0                  // max sublibraries at once (0 = no limit)

    // ------------------------------------------------- Cluster (slurm profile)
    queue           = null
    cluster_options = null              // e.g. '--account=igc'
    conda_env       = null              // conda env name/path with split-pipe (conda profile)

    help = false
}

process {
    withName: 'SPLIT_PIPE' {
        cpus    = params.split_cpus
        memory  = params.split_memory
        time    = params.split_time
        maxForks = params.max_parallel
    }
    withName: 'COMBINE' {
        cpus    = params.combine_cpus
        memory  = params.combine_memory
        time    = params.combine_time
    }
}

profiles {
    // Default: run on the current machine
    standard {
        process.executor = 'local'
    }
    // Submit each step as a SLURM job
    slurm {
        process.executor       = 'slurm'
        process.queue          = params.queue
        process.clusterOptions = params.cluster_options
        executor.queueSize     = 50
    }
    // Activate a conda env containing split-pipe (set params.conda_env)
    conda {
        conda.enabled  = true
        process.conda  = params.conda_env
    }
}

// Run reports, written next to the results
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
